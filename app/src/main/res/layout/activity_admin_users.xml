<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1412">

    <!-- Back + Title -->
    <LinearLayout
        android:id="@+id/topBar"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF"
            android:layout_width="22dp"
            android:layout_height="22dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:text="Users"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Search bar -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchBox"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        app:boxBackgroundColor="#1C201E"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="#7A8A85"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputSearch"
            android:hint="Search users"
            android:textColor="#FFFFFF"
            android:textColorHint="#7A8A85"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Filters -->
    <LinearLayout
        android:id="@+id/filterRow"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:layout_marginStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/searchBox"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Role filter -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRole"
            android:text="Organizer"
            android:textAllCaps="false"
            app:icon="@drawable/ic_arrow_down"
            app:iconGravity="textEnd"
            app:iconTint="#0F1412"
            android:paddingHorizontal="20dp"
            android:textColor="#0F1412"
            app:backgroundTint="#4AE3C1"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <!-- Status filter (stub) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatus"
            android:text="Status"
            android:textAllCaps="false"
            app:icon="@drawable/ic_arrow_down"
            app:iconGravity="textEnd"
            app:iconTint="#FFFFFF"
            android:paddingHorizontal="20dp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1C201E"
            android:layout_marginStart="10dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- RecyclerView list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerUsers"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="10dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/filterRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adminBottomNav" />

    <include
        android:id="@+id/adminBottomNav"
        layout="@layout/layout_admin_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
