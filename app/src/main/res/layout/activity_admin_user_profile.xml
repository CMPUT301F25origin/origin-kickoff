<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0F1412"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Back + Edit -->
    <LinearLayout
        android:id="@+id/topBar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:contentDescription="@string/back"
            android:layout_width="22dp"
            android:layout_height="22dp"/>

        <TextView
            android:id="@+id/txtProfile"
            android:text="@string/profile_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btnEdit"
            android:src="@drawable/ic_edit"
            app:tint="#FFFFFF"
            android:contentDescription="@string/edit_profile"
            android:layout_width="24dp"
            android:layout_height="24dp"/>

        <TextView
            android:text="@string/edit_profile"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginStart="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/profileScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adminBottomNav">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Profile Picture -->
            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                android:contentDescription="@string/profile_picture"
                android:scaleType="centerInside"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_circle_dark" />

            <!-- User Name -->
            <TextView
                android:id="@+id/txtName"
                android:text="@string/sample_user_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Email -->
            <TextView
                android:id="@+id/txtEmail"
                android:text="@string/sample_user_email"
                android:textColor="#B0BAB7"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Organized Events Title -->
            <TextView
                android:id="@+id/tvOrganizedHeader"
                android:text="@string/organized_events"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginTop="26dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrganizedEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"/>

            <!-- Joined Events Title -->
            <TextView
                android:id="@+id/tvJoinedHeader"
                android:text="@string/joined_events"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:layout_marginTop="26dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJoinedEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"/>

            <!-- Delete Profile -->
            <Button
                android:id="@+id/btnDeleteProfile"
                android:text="@string/delete_profile"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="26dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#C74333" />

            <!-- Device ID -->
            <TextView
                android:id="@+id/txtDeviceId"
                android:text="@string/device_id"
                android:textColor="#9AA3A1"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/adminBottomNav"
        layout="@layout/layout_admin_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
